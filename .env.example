# --- API ---
PORT=8080
DATABASE_URL=postgres://dreamdrive:dreamdrive@localhost:5432/dreamdrive?sslmode=disable
CORS_ORIGIN=http://localhost:3000

# development یا production. در حالت production کلید زیر الزامی است و
# سرور با کلید پیش‌فرض بالا نمی‌آید.
APP_ENV=development

# کلید امضای توکن. برای تولید یک مقدار امن:  openssl rand -hex 32
JWT_SECRET=342ab6e651ca64fbd443cd0938902671521233ee5e8d316a85ed8cbbf8b9d75d

# کلید مشترک با درگاه پرداخت. وب‌هوک بدون آن غیرفعال است و هر درخواست
# باید هدر X-Signature با HMAC-SHA256 روی بدنهٔ خام داشته باشد.
PAYMENT_WEBHOOK_SECRET=

# --- انبارهٔ فایل (تصاویر آپلودی پنل) ---
# local: روی دیسک همان سرور. ساده است ولی اگر بیش از یک نمونهٔ API داشته
#        باشی هر کدام فقط فایل‌های خودش را می‌بیند.
# s3   : هر سرویس سازگار با S3 (MinIO، Arvan، Liara، AWS…).
# با docker compose روی s3 بماند؛ MinIO همان‌جا بالا می‌آید. اگر بدون
# داکر و فقط با `go run` کار می‌کنی، local بگذار.
STORAGE_DRIVER=s3

# فقط برای حالت local: نشانی عمومی خود API، تا لینک فایل ساخته شود.
PUBLIC_URL=http://localhost:8080
UPLOAD_DIR=./data/uploads

# فقط برای حالت s3 — هر چهار مقدار الزامی‌اند وگرنه سرور بالا نمی‌آید.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dreamdrive
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# نشانی خواندن فایل‌ها از دید مرورگر (دامنهٔ CDN یا سطل عمومی).
# خالی یعنی از خود S3_ENDPOINT ساخته شود.
S3_PUBLIC_BASE=http://localhost:9000/dreamdrive
# MinIO و بیشتر سرویس‌های ایرانی path-style می‌خواهند؛ AWS واقعی false.
S3_PATH_STYLE=true

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8080
